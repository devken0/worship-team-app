# Copy to .env.local and fill in. See README for setup steps.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret protecting the /api/cleanup and /api/notifications/weekly endpoints.
CLEANUP_SECRET=
# Resend (https://resend.com) — notification email. Without these, the app still
# runs; notification sends are skipped (logged, never erroring).
RESEND_API_KEY=
# Verified sender; falls back to onboarding@resend.dev (Resend test sender) if unset.
EMAIL_FROM="Worship Team <onboarding@resend.dev>"
