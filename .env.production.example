# Production / self-hosted template (homelab + Cloudflare Tunnel).
# Copy to .env.production, fill in, then:
#   docker compose --env-file .env.production up --build -d
#
# NEXT_PUBLIC_* are baked into the build (see build.args in docker-compose.yml),
# so changing any of them needs a rebuild (--build), not just a restart.

# --- Supabase (your hosted project) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only secret; never reaches the browser

# --- Public origin the app is reached at ---
# Use your Cloudflare Tunnel hostname (https://), NOT localhost: invite links and
# group-chat reminder links are generated from this. Add this exact origin under
# Supabase -> Authentication -> URL Configuration -> Redirect URLs, or sign-in/
# invites will fail.
NEXT_PUBLIC_SITE_URL=https://worship.example.com

# --- Guards POST /api/cleanup and POST /api/notifications/weekly ---
# Generate one with: openssl rand -hex 32
CLEANUP_SECRET=generate-a-long-random-string

# --- Notification email (Resend) ---
# Server-only, read at runtime — no rebuild needed when these change. With no key
# set the app still runs and just skips sends (logged). Until you verify a sending
# domain in Resend, EMAIL_FROM must stay onboarding@resend.dev (delivers only to
# your own Resend account).
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="Worship Team <onboarding@resend.dev>"
